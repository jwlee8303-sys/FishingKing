{
  "name": "fishingking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/testing/e2e.mjs",
    "check": "node scripts/check.mjs",
    "assets:build": "node scripts/graphics/build.mjs",
    "assets:check": "node scripts/graphics/check.mjs",
    "assets:test": "node --test tests/graphics/pipeline.test.mjs",
    "assets:http": "node scripts/graphics/check-static.mjs",
    "test:paths": "node scripts/testing/paths.mjs",
    "test:soak": "node scripts/testing/stability.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xmldom/xmldom": "0.8.15",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
